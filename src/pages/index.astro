---
import "../styles/global.css";
import { DEFAULT_LOCATION } from "../lib/location";
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Rekomendasi waktu lari terbaik hari ini — aman dari bentrok sholat dan cuaca buruk."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=Oswald:wght@600;700&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <title>Kapan Lari</title>
  </head>
  <body>
    <main class="app">
      <header class="hero">
        <div class="hero__copy">
          <div class="hero__rail" aria-hidden="true"></div>
          <h1 class="brand">Kapan Lari</h1>
          <p class="tagline">
            Cari jam lari yang nyaman hari ini — tidak bentrok sholat, hindari hujan.
          </p>
        </div>
      </header>

      <section class="location" aria-labelledby="lokasi-heading">
        <p class="location__label" id="lokasi-heading">Langkah 1 · Lokasi kamu</p>
        <p class="location__active" data-location-label>{DEFAULT_LOCATION.label}</p>
        <p class="location__hint" data-location-hint hidden></p>

        <div class="location__controls">
          <button type="button" class="btn" data-geo-btn>
            <svg
              class="btn__icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="square"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="3"></circle>
              <path d="M12 2v3M12 19v3M2 12h3M19 12h3"></path>
              <path
                d="M12 5.5a6.5 6.5 0 1 1 0 13 6.5 6.5 0 0 1 0-13z"
                opacity="0.35"
              ></path>
            </svg>
            Pakai lokasi saya
          </button>
          <div class="search-field">
            <label for="city-search">Atau cari kota / kabupaten</label>
            <p class="search-field__help" id="city-search-help">
              Ketik minimal 2 huruf, lalu pilih dari daftar.
            </p>
            <input
              id="city-search"
              type="search"
              name="city"
              placeholder="Contoh: Bandung, Sleman, Depok"
              autocomplete="off"
              aria-describedby="city-search-help"
            />
            <ul
              class="search-results"
              data-search-results
              role="listbox"
              aria-label="Hasil pencarian kota"
              hidden
            ></ul>
            <p class="search-empty" data-search-empty hidden>
              Kota tidak ditemukan. Coba ejaan lain atau nama kabupaten.
            </p>
          </div>
        </div>
      </section>

      <section class="section" aria-labelledby="rekomendasi-heading" aria-live="polite">
        <div class="section__head">
          <h2 class="section__title" id="rekomendasi-heading">Slot lari hari ini</h2>
          <p class="section__lead">
            Urutan dari paling cocok. Slot bertanda Terbaik adalah pilihan utama.
          </p>
        </div>
        <div class="state state--loading" data-app-state>
          <div class="skeleton" data-loading-skeleton aria-hidden="true">
            <div class="skeleton__line skeleton__line--lg"></div>
            <div class="skeleton__line skeleton__line--md"></div>
            <div class="skeleton__line skeleton__line--sm"></div>
          </div>
          <p class="state__message" data-state-text>
            Sedang mencari slot lari terbaik untuk lokasimu…
          </p>
          <button type="button" class="btn btn--ghost" data-retry-btn hidden>
            Coba lagi
          </button>
        </div>
        <ul class="slot-list" data-slot-list hidden></ul>
      </section>

      <div class="context-stack">
        <section class="section section--secondary" aria-labelledby="sholat-heading">
          <div class="section__head">
            <h2 class="section__title" id="sholat-heading">Jadwal sholat</h2>
            <p class="section__lead">Dipakai supaya rekomendasi tidak bentrok waktu sholat.</p>
          </div>
          <dl class="prayer-grid" data-prayer-times>
            <div class="prayer-item">
              <dt>Subuh</dt>
              <dd data-prayer="Fajr">—</dd>
            </div>
            <div class="prayer-item">
              <dt>Zuhur</dt>
              <dd data-prayer="Dhuhr">—</dd>
            </div>
            <div class="prayer-item">
              <dt>Ashar</dt>
              <dd data-prayer="Asr">—</dd>
            </div>
            <div class="prayer-item">
              <dt>Maghrib</dt>
              <dd data-prayer="Maghrib">—</dd>
            </div>
            <div class="prayer-item">
              <dt>Isya</dt>
              <dd data-prayer="Isha">—</dd>
            </div>
          </dl>
        </section>

        <section class="section section--secondary" aria-labelledby="cuaca-heading">
          <div class="section__head">
            <h2 class="section__title" id="cuaca-heading">Cuaca hari ini</h2>
            <p class="section__lead">Ringkas dulu, lalu lihat peluang hujan per jam.</p>
          </div>
          <dl class="meta-grid" data-weather-summary>
            <div class="meta-block">
              <dt>Suhu min / maks</dt>
              <dd data-weather-temp>— / —</dd>
            </div>
            <div class="meta-block">
              <dt>Hujan tertinggi</dt>
              <dd data-weather-rain>—</dd>
            </div>
            <div class="meta-block meta-block--wide">
              <dt>Kondisi</dt>
              <dd data-weather-condition>—</dd>
            </div>
          </dl>

          <div class="hourly-chart" data-hourly-chart hidden>
            <p class="hourly-chart__title" id="chart-heading">Peluang hujan per jam (05–21)</p>
            <div
              class="hourly-chart__bars"
              data-hourly-bars
              role="img"
              aria-labelledby="chart-heading"
            ></div>
            <p class="hourly-chart__legend">Semakin tinggi batang, semakin besar peluang hujan.</p>
          </div>
        </section>
      </div>

      <footer class="footer">
        <p>
          Cuaca dari{" "}
          <a href="https://open-meteo.com/" rel="noopener noreferrer">Open-Meteo</a>
          . Jadwal sholat dari{" "}
          <a href="https://aladhan.com/" rel="noopener noreferrer">Aladhan</a>.
        </p>
      </footer>
    </main>

    <script>
      import { DEFAULT_LOCATION } from "../lib/location";
      import type {
        Coordinates,
        HourlyWeather,
        PrayerName,
        RunSlot,
      } from "../lib/location";
      import {
        formatNearestPrayer,
        prayerLabel,
        weatherConditionLabel,
      } from "../lib/display";
      import { searchCities } from "../lib/geocoding";
      import { fetchPrayerTimings } from "../lib/prayer";
      import {
        chartBarsFromHourly,
        fetchHourlyWeather,
        summarizeWeather,
      } from "../lib/weather";
      import {
        emptyStateMessage,
        recommendRunSlots,
      } from "../lib/recommendRunSlots";

      const ERROR_COPY =
        "Data belum bisa dimuat. Periksa koneksi internet, lalu coba lagi.";
      const LOADING_COPY = "Sedang mencari slot lari terbaik untuk lokasimu…";
      const GEO_DENY_COPY =
        "Lokasi ditolak atau gagal. Tetap di lokasi aktif — cari kota di bawah.";
      const GEO_UNSUPPORTED_COPY =
        "Peramban tidak mendukung lokasi. Cari kota di bawah saja.";
      const GEO_LOADING_COPY = "Mengambil lokasi perangkat…";
      const SEARCH_EMPTY_COPY =
        "Kota tidak ditemukan. Coba ejaan lain atau nama kabupaten.";
      const PRAYER_ORDER: PrayerName[] = [
        "Fajr",
        "Dhuhr",
        "Asr",
        "Maghrib",
        "Isha",
      ];
      const SEARCH_DEBOUNCE_MS = 300;

      const locationLabel = document.querySelector(
        "[data-location-label]",
      ) as HTMLElement;
      const locationHint = document.querySelector(
        "[data-location-hint]",
      ) as HTMLElement;
      const geoBtn = document.querySelector(
        "[data-geo-btn]",
      ) as HTMLButtonElement;
      const citySearch = document.querySelector(
        "#city-search",
      ) as HTMLInputElement;
      const searchResults = document.querySelector(
        "[data-search-results]",
      ) as HTMLUListElement;
      const searchEmpty = document.querySelector(
        "[data-search-empty]",
      ) as HTMLElement;
      const stateEl = document.querySelector("[data-app-state]") as HTMLElement;
      const stateText = document.querySelector(
        "[data-state-text]",
      ) as HTMLElement;
      const retryBtn = document.querySelector(
        "[data-retry-btn]",
      ) as HTMLButtonElement;
      const slotList = document.querySelector(
        "[data-slot-list]",
      ) as HTMLUListElement;
      const weatherTemp = document.querySelector(
        "[data-weather-temp]",
      ) as HTMLElement;
      const weatherRain = document.querySelector(
        "[data-weather-rain]",
      ) as HTMLElement;
      const weatherCondition = document.querySelector(
        "[data-weather-condition]",
      ) as HTMLElement;
      const hourlyChart = document.querySelector(
        "[data-hourly-chart]",
      ) as HTMLElement;
      const hourlyBars = document.querySelector(
        "[data-hourly-bars]",
      ) as HTMLElement;

      let activeLocation: Coordinates = { ...DEFAULT_LOCATION };
      let searchTimer: ReturnType<typeof setTimeout> | null = null;
      let searchRequestId = 0;
      let locationLabelTimer: ReturnType<typeof setTimeout> | null = null;

      function prefersReducedMotion(): boolean {
        return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      }

      /** Double-rAF so CSS transitions start from the pre-enter state (interruptible). */
      function revealEntered(elements: Element[], className: string): void {
        const apply = () => {
          for (const el of elements) el.classList.add(className);
        };
        if (prefersReducedMotion() || elements.length === 0) {
          apply();
          return;
        }
        requestAnimationFrame(() => {
          requestAnimationFrame(apply);
        });
      }

      function updateLocationLabel(label: string): void {
        if (locationLabel.textContent === label) return;
        if (locationLabelTimer !== null) {
          clearTimeout(locationLabelTimer);
          locationLabelTimer = null;
        }
        if (prefersReducedMotion()) {
          locationLabel.classList.remove("is-dim");
          locationLabel.textContent = label;
          return;
        }
        locationLabel.classList.add("is-dim");
        locationLabelTimer = setTimeout(() => {
          locationLabel.textContent = label;
          locationLabel.classList.remove("is-dim");
          locationLabelTimer = null;
        }, 120);
      }

      function formatHourRange(start: Date, end: Date, timeZone: string): string {
        const fmt = new Intl.DateTimeFormat("id-ID", {
          timeZone,
          hour: "2-digit",
          minute: "2-digit",
          hourCycle: "h23",
        });
        return `${fmt.format(start)}–${fmt.format(end)}`;
      }

      function setLocationHint(message: string | null) {
        if (!message) {
          locationHint.hidden = true;
          locationHint.textContent = "";
          return;
        }
        locationHint.hidden = false;
        locationHint.textContent = message;
      }

      function clearSearchUi() {
        searchResults.hidden = true;
        searchResults.replaceChildren();
        searchEmpty.hidden = true;
        searchEmpty.textContent = SEARCH_EMPTY_COPY;
      }

      function showLoading() {
        stateEl.hidden = false;
        stateEl.classList.add("state--loading");
        stateEl.classList.remove("state--error");
        stateText.textContent = LOADING_COPY;
        retryBtn.hidden = true;
        slotList.hidden = true;
        slotList.replaceChildren();
      }

      function showError() {
        stateEl.hidden = false;
        stateEl.classList.remove("state--loading");
        stateEl.classList.add("state--error");
        stateText.textContent = ERROR_COPY;
        retryBtn.hidden = false;
        slotList.hidden = true;
        slotList.replaceChildren();
      }

      function showEmpty(message: string) {
        stateEl.hidden = false;
        stateEl.classList.remove("state--loading");
        stateEl.classList.remove("state--error");
        stateText.textContent = message;
        retryBtn.hidden = true;
        slotList.hidden = true;
        slotList.replaceChildren();
      }

      function appendMetaRow(
        dl: HTMLDListElement,
        term: string,
        value: string,
      ): void {
        const wrap = document.createElement("div");
        wrap.className = "slot__meta-item";

        const dt = document.createElement("dt");
        dt.textContent = term;

        const dd = document.createElement("dd");
        dd.textContent = value;

        wrap.append(dt, dd);
        dl.append(wrap);
      }

      function showSlots(slots: RunSlot[], timeZone: string) {
        stateEl.hidden = true;
        stateEl.classList.remove("state--loading", "state--error");
        retryBtn.hidden = true;
        slotList.hidden = false;
        slotList.replaceChildren();

        const items: HTMLElement[] = [];
        slots.forEach((slot, index) => {
          const li = document.createElement("li");
          li.className = slot.isBest ? "slot slot--best" : "slot";
          li.style.setProperty("--slot-index", String(index));

          const header = document.createElement("div");
          header.className = "slot__header";

          const time = document.createElement("p");
          time.className = "slot__time";
          time.textContent = formatHourRange(slot.start, slot.end, timeZone);

          header.append(time);
          if (slot.isBest) {
            const badge = document.createElement("span");
            badge.className = "slot__badge";
            badge.textContent = "Terbaik";
            header.append(badge);
          }

          // Meta wajib US-2 / PRD §8: suhu, % hujan, sholat terdekat, alasan
          const meta = document.createElement("dl");
          meta.className = "slot__meta-grid";
          appendMetaRow(meta, "Suhu", `${Math.round(slot.temperatureC)}°C`);
          appendMetaRow(meta, "Hujan", `${slot.precipitationProbability}%`);
          appendMetaRow(
            meta,
            "Sholat terdekat",
            formatNearestPrayer(slot.nearestPrayer),
          );

          const reasons = document.createElement("p");
          reasons.className = "slot__reasons";
          reasons.textContent = slot.reasons.join(" · ");

          li.append(header, meta, reasons);
          slotList.append(li);
          items.push(li);
        });

        revealEntered(items, "slot--enter");
      }

      function renderPrayerTimes(
        timings: Record<PrayerName, string>,
      ): void {
        for (const name of PRAYER_ORDER) {
          const el = document.querySelector(
            `[data-prayer="${name}"]`,
          ) as HTMLElement | null;
          if (el) {
            el.textContent = timings[name];
            el.setAttribute("aria-label", `${prayerLabel(name)} ${timings[name]}`);
          }
        }
      }

      function clearHourlyChart() {
        hourlyChart.hidden = true;
        hourlyBars.replaceChildren();
        hourlyBars.removeAttribute("aria-label");
      }

      function renderHourlyChart(
        hourly: HourlyWeather[],
        options: { enterDelayMs?: number } = {},
      ) {
        const bars = chartBarsFromHourly(hourly);
        hourlyBars.replaceChildren();

        if (bars.length === 0) {
          clearHourlyChart();
          return;
        }

        const enterDelayMs = options.enterDelayMs ?? 0;
        hourlyChart.style.setProperty("--chart-enter-delay", `${enterDelayMs}ms`);

        const ariaParts: string[] = [];
        const fills: HTMLElement[] = [];
        bars.forEach((bar, index) => {
          const col = document.createElement("div");
          col.className = "hourly-chart__col";

          const track = document.createElement("div");
          track.className = "hourly-chart__track";

          const fill = document.createElement("div");
          fill.className = "hourly-chart__bar";
          fill.style.setProperty("--bar-height", `${bar.heightPercent}%`);
          fill.style.setProperty("--bar-index", String(index));
          fill.title = `${bar.hourLabel}:00 — hujan ${bar.precipitationProbability}%, ${Math.round(bar.temperatureC)}°C`;

          const label = document.createElement("span");
          label.className = "hourly-chart__hour";
          label.textContent = bar.hourLabel;

          track.append(fill);
          col.append(track, label);
          hourlyBars.append(col);
          fills.push(fill);

          ariaParts.push(
            `${bar.hourLabel}:00 ${bar.precipitationProbability}% hujan`,
          );
        });

        hourlyBars.setAttribute(
          "aria-label",
          `Grafik peluang hujan: ${ariaParts.join("; ")}`,
        );
        hourlyChart.hidden = false;
        revealEntered(fills, "bar--enter");
      }

      function clearMetaPlaceholders() {
        for (const name of PRAYER_ORDER) {
          const el = document.querySelector(
            `[data-prayer="${name}"]`,
          ) as HTMLElement | null;
          if (el) el.textContent = "—";
        }
        weatherTemp.textContent = "— / —";
        weatherRain.textContent = "—";
        weatherCondition.textContent = "—";
        clearHourlyChart();
      }

      async function loadForLocation(location: Coordinates) {
        activeLocation = location;
        updateLocationLabel(location.label);
        showLoading();
        clearMetaPlaceholders();

        try {
          const [prayerTimings, weather] = await Promise.all([
            fetchPrayerTimings(location),
            fetchHourlyWeather(location),
          ]);

          const timezone = weather.timezone || location.timezone;
          activeLocation = { ...location, timezone };
          updateLocationLabel(activeLocation.label);

          renderPrayerTimes(prayerTimings);

          const summary = summarizeWeather(weather.hourly);
          weatherTemp.textContent = `${Math.round(summary.minTempC)}° / ${Math.round(summary.maxTempC)}°`;
          weatherRain.textContent = `${summary.maxPrecipitationProbability}%`;
          weatherCondition.textContent = weatherConditionLabel(
            summary.conditionCode,
          );

          const result = recommendRunSlots({
            now: new Date(),
            timezone,
            prayerTimings,
            hourlyWeather: weather.hourly,
          });

          // Slots first, then chart with delay — one focal point at a time
          if (result.slots.length === 0) {
            const summaryDiscarded = result.discardedSummary ?? {
              past: 0,
              prayerConflict: 0,
              unsafeWeather: 0,
            };
            showEmpty(emptyStateMessage(summaryDiscarded));
            renderHourlyChart(weather.hourly, { enterDelayMs: 0 });
            return;
          }

          showSlots(result.slots, timezone);
          renderHourlyChart(weather.hourly, { enterDelayMs: 200 });
        } catch {
          showError();
        }
      }

      function renderSearchResults(cities: Coordinates[]) {
        searchResults.replaceChildren();
        if (cities.length === 0) {
          searchResults.hidden = true;
          searchEmpty.hidden = false;
          searchEmpty.textContent = SEARCH_EMPTY_COPY;
          return;
        }

        searchEmpty.hidden = true;
        searchResults.hidden = false;

        for (const city of cities) {
          const li = document.createElement("li");
          li.setAttribute("role", "option");

          const button = document.createElement("button");
          button.type = "button";
          button.className = "search-results__item";
          button.textContent = city.label;
          button.addEventListener("click", () => {
            citySearch.value = "";
            clearSearchUi();
            setLocationHint(null);
            void loadForLocation(city);
          });

          li.append(button);
          searchResults.append(li);
        }
      }

      async function runCitySearch(query: string) {
        const trimmed = query.trim();
        if (trimmed.length < 2) {
          clearSearchUi();
          return;
        }

        const requestId = ++searchRequestId;
        try {
          const cities = await searchCities(trimmed);
          if (requestId !== searchRequestId) return;
          renderSearchResults(cities);
        } catch {
          if (requestId !== searchRequestId) return;
          searchResults.hidden = true;
          searchResults.replaceChildren();
          searchEmpty.hidden = false;
          searchEmpty.textContent = SEARCH_EMPTY_COPY;
        }
      }

      function requestGeolocation() {
        if (!navigator.geolocation) {
          setLocationHint(GEO_UNSUPPORTED_COPY);
          return;
        }

        geoBtn.disabled = true;
        setLocationHint(GEO_LOADING_COPY);

        navigator.geolocation.getCurrentPosition(
          (position) => {
            geoBtn.disabled = false;
            setLocationHint(null);
            clearSearchUi();
            citySearch.value = "";
            void loadForLocation({
              latitude: position.coords.latitude,
              longitude: position.coords.longitude,
              label: "Lokasi saat ini",
              timezone: activeLocation.timezone,
            });
          },
          () => {
            geoBtn.disabled = false;
            // Tetap di lokasi aktif; UI tidak di-block (RFC §5.4 / PLANNING E3.1)
            setLocationHint(GEO_DENY_COPY);
          },
          {
            enableHighAccuracy: false,
            timeout: 10_000,
            maximumAge: 60_000,
          },
        );
      }

      geoBtn.addEventListener("click", () => {
        requestGeolocation();
      });

      citySearch.addEventListener("input", () => {
        if (searchTimer !== null) clearTimeout(searchTimer);
        const value = citySearch.value;
        searchTimer = setTimeout(() => {
          void runCitySearch(value);
        }, SEARCH_DEBOUNCE_MS);
      });

      retryBtn.addEventListener("click", () => {
        void loadForLocation(activeLocation);
      });

      // First load Jakarta; tidak auto-prompt geo (PRD Q12 / PLANNING E4.3)
      // Lokasi sesi tidak disimpan ke localStorage (PRD Q19)
      void loadForLocation(DEFAULT_LOCATION);
    </script>
  </body>
</html>
